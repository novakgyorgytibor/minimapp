{
  "expo": {
    "name": "MinimApp",
    "slug": "minimap",
    "version": "0.1.26",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "hu.minimapp.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Navigation needs your location.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "26"
    },
    "android": {
      "package": "hu.minimapp.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 26
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Navigation needs your location."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e340f88-174a-41f1-ad40-aae82edd43ef"
      }
    },
    "owner": "novakgyorgytibor"
  }
}
