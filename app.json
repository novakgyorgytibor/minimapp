{
  "expo": {
    "name": "minimap",
    "slug": "minimap",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": { "backgroundColor": "#000000", "resizeMode": "contain" },
    "ios": {
      "bundleIdentifier": "hu.minimap.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Navigation needs your location."
      }
    },
    "android": {
      "package": "hu.minimap.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Navigation needs your location." }
      ]
    ]
  }
}
